# Copy this file to `.env` and fill in the values.
# `.env` is git-ignored. Never commit real keys — this repository is public.
#
# In CI these come from GitHub repository secrets/variables instead, so `.env`
# is a local-development convenience only.

# TMDB "API Key (v3 auth)" — the 32-character hex string.
# NOT the "API Read Access Token", which is a long JWT starting with `eyJ...`
# and will not work here; the pipeline passes this as ?api_key= in the query.
# Get one at https://www.themoviedb.org/settings/api
# Leave blank to run without artwork: the pipeline degrades to a text-only
# listing rather than failing.
TMDB_API_KEY=

# Where the pipeline reads the previous snapshot from, so a failing source
# degrades to its last good data instead of vanishing. Point this at the
# deployed site once it exists. Safe to leave unset before the first deploy —
# a missing baseline is handled and simply means no carry-forward.
BASELINE_URL=
